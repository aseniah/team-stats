# Copy to .env (gitignored). Scripts load it automatically.

# Jira, for `./refresh.sh` and `sync-periods.mjs --from-jira`.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# Tokens expire after at most a year; the sync fails with a 401 once yours does.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional. The token's expiry date (YYYY-MM-DD); the sync warns 14 days before it.
JIRA_TOKEN_EXPIRES=
# Optional. The part before .atlassian.net in your Jira URL, such as acme for acme.atlassian.net. Needed for a classic
# (unscoped) token; without it requests go through api.atlassian.com with each team's cloudId.
JIRA_SITE=

# Optional. A GitHub token for unattended runs; without it `gh` uses your `gh auth login`.
# Needs read access to the org's repos and pull requests.
GH_TOKEN=
